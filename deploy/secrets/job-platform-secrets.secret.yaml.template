apiVersion: v1
kind: Secret
metadata:
  name: job-platform-secrets
  namespace: jobs-platform
type: Opaque
stringData:
  # Host Postgres on thenetwork (localhost:5432)
  DATABASE_URL: "postgresql+psycopg://jobs_platform:REPLACE_DB_PASSWORD@localhost:5432/jobs_platform"
  SECRET_KEY: "REPLACE_SECRET_KEY"
  ADMIN_SECRET: "REPLACE_ADMIN_SECRET"
  INTERNAL_EVENTS_TOKEN: "REPLACE_INTERNAL_EVENTS_TOKEN"
  # Tier-1 ingest (rotate keys — never commit real values)
  ADZUNA_APP_ID: ""
  ADZUNA_APP_KEY: ""
  JSEARCH_API_KEY: ""
  JSEARCH_ENABLED: "false"
  USAJOBS_API_KEY: ""
  USAJOBS_USER_AGENT: ""
  # Transactional email (SES/Postmark/etc.)
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASSWORD: ""
  EMAIL_FROM: "Willow River Automation <hello@willowriverautomation.com>"
  # Browser-restricted Google Maps key (address autocomplete)
  GOOGLE_MAPS_API_KEY: ""
  # Stripe billing (live keys — never commit real values)
  STRIPE_SECRET_KEY: ""
  STRIPE_WEBHOOK_SECRET: ""
  STRIPE_PRICE_ID_MONTHLY_999: ""
  STRIPE_PRICE_ID_MONTHLY_1499: ""
