# Environment variables for local development.
# Copy to .env and fill in values.

# PostgreSQL connection (homelab database namespace; sync driver matches core/database.py)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jobs_platform

# Ollama OpenAI-compatible endpoint (host systemd service on thenetwork)
OLLAMA_BASE_URL=http://localhost:11434/v1
# OpenAI-compatible LLM endpoint (swap cloud provider via env only)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_NUM_PARALLEL=1
INTERACTIVE_NUM_CTX=4096
INTERACTIVE_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=30m
ADVISOR_NUM_PREDICT=512
BUILDER_NUM_PREDICT=1024
ADVISOR_RATE_LIMIT_PER_MIN=10
BUILDER_RATE_LIMIT_PER_MIN=6
ADVISOR_FIFO_BUSY_DEPTH=3
INFERENCE_TIMEOUT_SECONDS=300
ADVISOR_REPLY_MAX_CHARS=8000
ADVISOR_REPLY_MAX_TOKENS=2000
APPLY_ASSIST_REPLY_MAX_CHARS=8000
APPLY_ASSIST_REPLY_MAX_TOKENS=1200

# Advisor market research (in-cluster SearXNG)
SEARXNG_BASE_URL=http://searxng.searxng.svc.cluster.local:8080
ADVISOR_RESEARCH_ENABLED=true

# Apply Assist Browser (Playwright Chromium)
APPLY_BROWSER_ENABLED=true
APPLY_BROWSER_MAX_SESSIONS=2
APPLY_BROWSER_IDLE_SECONDS=900

# Tier-1 ingest APIs (store in homelab-infra SOPS for prod — never commit real keys)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
JSEARCH_ENABLED=false
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Transactional email (digests + magic links)
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=JobPicks <hello@willowriverautomation.com>
APP_BASE_URL=https://app.willowriverautomation.com
APP_ALT_BASE_URLS=https://jobs.jbuschmann.com

# Stripe billing (Phase 3 / Workstream B)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY_999=
STRIPE_PRICE_ID_MONTHLY_1499=
REQUIRE_JOBS_ROLE=false
METRICS_TOKEN=

# Admin dashboard (E2.12)
ADMIN_SECRET=dev-admin-change-me

EXTERNAL_CHECKOUT_STOREFRONTS=US
APPLE_BUNDLE_ID=com.jbuschmann.jobpicks
ANDROID_PACKAGE=com.jbuschmann.jobpicks
# APPLE_TEAM_ID=
# ANDROID_SHA256_CERT_FINGERPRINT=

# Resume storage (onboarding uploads)
RESUME_STORAGE_DIR=/tmp/job-platform/resumes

# Nightly batch sizes (1660S GPU — keep conservative)
NORMALIZE_BATCH_SIZE=50
EMBED_BATCH_SIZE=200
